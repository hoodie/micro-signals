{
    "name": "@hoodie/signals",
    "version": "2.11.1",
    "description": "A tiny typed messaging system inspired by js-signals that uses ES2015 sets",
    "main": "lib/src/index.js",
    "module": "lib/src/index.js",
    "exports": {
        ".": "./lib/src/index.js"
    },
    "types": "lib/src/index.d.ts",
    "type": "module",
    "devDependencies": {
        "@tsconfig/strictest": "2.0.3",
        "@types/node": "20.11.24",

        "typescript": "^7.0.2"
    },
    "scripts": {
        "lint": "deno fmt --check && deno lint",
        "fmt": "deno fmt",
        "test": "deno task test",
        "test:node": "tsc --project tsconfig.json && node --test lib/test/*.spec.js",
        "build": "tsc --project tsconfig.json"
    },
    "keywords": [
        "signals",
        "signal",
        "TypeScript",
        "ts",
        "typed",
        "eventer",
        "events",
        "event",
        "messaging",
        "pubsub"
    ],
